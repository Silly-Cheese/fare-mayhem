rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSingleOwner() {
      return request.auth != null
        && request.auth.token.fmOwner == true
        && firestore.get(/databases/(default)/documents/_system/owner).data.uid == request.auth.uid;
    }
    match /card-art/{cardId}/original/{fileName} {
      allow read: if isSingleOwner();
      allow create: if isSingleOwner()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    match /card-art/{cardId}/cartoon/{fileName} {
      allow read: if isSingleOwner();
      allow create: if isSingleOwner()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    match /card-art/{cardId}/finished/{fileName} {
      allow read: if isSingleOwner();
      allow create: if isSingleOwner()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
